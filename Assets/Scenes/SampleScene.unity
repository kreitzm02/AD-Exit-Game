      objectReference: {fileID: 1266715986469135529, guid: d39f923bf8a5c8c4fa9ad591a4b4e85f, type: 3}
    - target: {fileID: 4923332934719268576, guid: 1b90ee29d4f8f48408452ced94754ffd, type: 3}
      propertyPath: slots.Array.data[3].readableMode
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 4923332934719268576, guid: 1b90ee29d4f8f48408452ced94754ffd, type: 3}
      propertyPath: slots.Array.data[5].readableIcon
      value: 
      objectReference: {fileID: 1266715986469135529, guid: d39f923bf8a5c8c4fa9ad591a4b4e85f, type: 3}
    - target: {fileID: 4923332934719268576, guid: 1b90ee29d4f8f48408452ced94754ffd, type: 3}
      propertyPath: slots.Array.data[5].readableMode
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 4923332934719268576, guid: 1b90ee29d4f8f48408452ced94754ffd, type: 3}
      propertyPath: slots.Array.data[3].readableFullText
      value: "23. Juni 2009\n\r\nDie Schule war heute echt langweilig. Ich freue
        mich schon n\xE4chstes Jahr auf den neuen Stundenplan. Wer kommt auf die
        Idee 2 Stunden Deutsch und 2 Stunden Mathe hintereinander zu legen. Da kann
        man sich doch \xFCberhaupt nicht konzentrieren. Vor allem Mathe f\xFChlt
        sich dann immer sooo lang an. Immerhin sitze ich seit ein paar Wochen neben
        Leonie, wodurch sich der Unterricht nicht so stark zieht. Ich habs vermisst
        neben meinen Freunden zu sitzen. Davor musste ich ein halbes Jahr neben Torben
        sitzen und den mag ich nicht. Torben hat sich immer nur \xFCber mich lustig
        gemacht, weil ich als Junge mit Leonie befreundet bin. Ich versteh wirklich
        sein Problem damit nicht, dass ich Jungs und M\xE4dchen mag, aber Torben
        ist nun mal ein Idiot. Immerhin sitzt er jetzt in der ganz anderen Ecke vom
        Klassenraum. Zur Nachmittagsbetreuung musste ich heute auch nicht, weil\r\nPapa
        fr\xFCher von der Arbeit gehen durfte und mich direkt eingesammelt hat. Papa
        hatte mich gar nicht erst gefragt, wie die Schule war, er wei\xDF genau,
        dass ich den Unterricht dienstags nicht mag, aber er hatte mich gefragt,
        ob ich mit ihm den zweiten Star Wars Teil gucken m\xF6chte. Selbstverst\xE4ndlich
        hab ich sofort ja gesagt und er hat mir versprochen, dass wir ihn morgen
        Abend zusammen gucken.\r\nKomischerweise hat Papa mich auch gefragt, ob Mama
        mal mein Tagebuch lesen d\xFCrfte. Mama soll wohl zu ihm gegangen sein und
        ihn gefragt haben, ob er mich mal fragen k\xF6nnte. Aber ich hab auch Papa
        gesagt, dass ich nicht m\xF6chte, dass irgendjemand mein Tagebuch liest,
        weil ich das f\xFCr mich\r\nschreibe. Ich wei\xDF nicht, warum Mama so neugierig
        ist. Ich wei\xDF nicht, wann ich sie das letzte Mal so interessiert an meinen
        Hobbys gesehen habe."
      objectReference: {fileID: 0}
    - target: {fileID: 4923332934719268576, guid: 1b90ee29d4f8f48408452ced94754ffd, type: 3}
      propertyPath: slots.Array.data[5].readableFullText
      value: "24. Juni 2009\n\r\nPapa und ich haben endlich den zweiten Star Wars
        Film geguckt! Ich hab zwar immer noch nicht ganz verstanden, warum der zweite
        Teil \u201EEpisode 5\u201C hei\xDFt, aber es wird schon stimmen, wenn Papa
        das sagt. Den Film fand ich sogar noch besser als den Ersten und Papa hat
        mir versprochen, dass wir\r\nam Wochenende zusammen in die Stadt fahren und
        ich mir ein Spielzeug Raumschiff aussuchen darf. Ich kann\u2019s kaum erwarten
        :)))"
      objectReference: {fileID: 0}
    - target: {fileID: 4923332934719268576, guid: 1b90ee29d4f8f48408452ced94754ffd, type: 3}
      propertyPath: slots.Array.data[3].readableCharLimitPerPage
