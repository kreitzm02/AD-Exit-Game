    - target: {fileID: 8334727942531066475, guid: c3b9b1aeebcb3e0438dfc54c33fc39d4, type: 3}
      propertyPath: sequences.Array.data[4].steps.Array.data[0].duration
      value: 2
      objectReference: {fileID: 0}
    - target: {fileID: 8334727942531066475, guid: c3b9b1aeebcb3e0438dfc54c33fc39d4, type: 3}
      propertyPath: sequences.Array.data[4].steps.Array.data[1].duration
      value: 2
      objectReference: {fileID: 0}
    - target: {fileID: 8334727942531066475, guid: c3b9b1aeebcb3e0438dfc54c33fc39d4, type: 3}
      propertyPath: sequences.Array.data[0].steps.Array.data[0].subtitleText
      value: 'Kara: Hmm komisch. Hier scheint was zu fehlen. Eine Art Glasscherbe
        glaube ich.'
      objectReference: {fileID: 0}
    - target: {fileID: 8334727942531066475, guid: c3b9b1aeebcb3e0438dfc54c33fc39d4, type: 3}
      propertyPath: sequences.Array.data[0].steps.Array.data[1].subtitleText
      value: 'Jekko: Ja! Ja! Endlich wieder und dann ausgerechnet hier! Jiahahaha!'
      objectReference: {fileID: 0}
    - target: {fileID: 8334727942531066475, guid: c3b9b1aeebcb3e0438dfc54c33fc39d4, type: 3}
      propertyPath: sequences.Array.data[0].steps.Array.data[2].subtitleText
      value: 'Kara: Ruhe jetzt! In dem Zustand bist du mir eh keine Hilfe.'
      objectReference: {fileID: 0}
    - target: {fileID: 8334727942531066475, guid: c3b9b1aeebcb3e0438dfc54c33fc39d4, type: 3}
      propertyPath: sequences.Array.data[0].steps.Array.data[3].subtitleText
      value: 'Kara: Ruhe jetzt! In dem Zustand bist du mir eh keine Hilfe.'
      objectReference: {fileID: 0}
    - target: {fileID: 8334727942531066475, guid: c3b9b1aeebcb3e0438dfc54c33fc39d4, type: 3}
      propertyPath: sequences.Array.data[0].steps.Array.data[4].subtitleText
      value: "Jekko: Hehe, viel Gl\xFCck dabei!"
      objectReference: {fileID: 0}
    - target: {fileID: 8334727942531066475, guid: c3b9b1aeebcb3e0438dfc54c33fc39d4, type: 3}
      propertyPath: sequences.Array.data[0].steps.Array.data[5].subtitleText
      value: 
      objectReference: {fileID: 0}
    - target: {fileID: 8334727942531066475, guid: c3b9b1aeebcb3e0438dfc54c33fc39d4, type: 3}
      propertyPath: sequences.Array.data[0].steps.Array.data[6].subtitleText
      value: 
      objectReference: {fileID: 0}
    - target: {fileID: 8334727942531066475, guid: c3b9b1aeebcb3e0438dfc54c33fc39d4, type: 3}
      propertyPath: sequences.Array.data[1].steps.Array.data[0].subtitleText
      value: 'Kara: Nein, da fehlt die Scherbe. Hier komme ich nicht weiter.'
      objectReference: {fileID: 0}
    - target: {fileID: 8334727942531066475, guid: c3b9b1aeebcb3e0438dfc54c33fc39d4, type: 3}
      propertyPath: sequences.Array.data[1].steps.Array.data[1].subtitleText
      value: "JEKKO: (ironisch)Ich w\xFCrd dir ja raten,\r\nmach nen Arzttermin.
        Aber selbst\r\ndas w\xFCrdest du wohl vergessen"
      objectReference: {fileID: 0}
    - target: {fileID: 8334727942531066475, guid: c3b9b1aeebcb3e0438dfc54c33fc39d4, type: 3}
      propertyPath: sequences.Array.data[2].steps.Array.data[0].subtitleText
      value: 
      objectReference: {fileID: 0}
    - target: {fileID: 8334727942531066475, guid: c3b9b1aeebcb3e0438dfc54c33fc39d4, type: 3}
      propertyPath: sequences.Array.data[2].steps.Array.data[1].subtitleText
      value: 'Jekko: Wenn du das noch einmal versuchst, dann gehe ich doch nicht
        mehr davon aus, das du es hier raus scahffst.'
      objectReference: {fileID: 0}
    - target: {fileID: 8334727942531066475, guid: c3b9b1aeebcb3e0438dfc54c33fc39d4, type: 3}
      propertyPath: sequences.Array.data[2].steps.Array.data[2].subtitleText
      value: 
      objectReference: {fileID: 0}
    - target: {fileID: 8334727942531066475, guid: c3b9b1aeebcb3e0438dfc54c33fc39d4, type: 3}
      propertyPath: sequences.Array.data[3].steps.Array.data[0].subtitleText
      value: 
      objectReference: {fileID: 0}
    - target: {fileID: 8334727942531066475, guid: c3b9b1aeebcb3e0438dfc54c33fc39d4, type: 3}
      propertyPath: sequences.Array.data[3].steps.Array.data[1].subtitleText
      value: "Jekko: Lass es jetzt endlich, bevor ich dir die Gliedma\xDFen rausrei\xDFe,
        damit du das verdammte Teil nicht mehr anr\xFChrst. Da fehlt immer noch was,
        checkst du es denn nicht??"
      objectReference: {fileID: 0}
    - target: {fileID: 8334727942531066475, guid: c3b9b1aeebcb3e0438dfc54c33fc39d4, type: 3}
      propertyPath: sequences.Array.data[4].steps.Array.data[0].subtitleText
      value: '[ NO TEXT - CHEST OPEN SFX]'
      objectReference: {fileID: 0}
    - target: {fileID: 8334727942531066475, guid: c3b9b1aeebcb3e0438dfc54c33fc39d4, type: 3}
      propertyPath: sequences.Array.data[4].steps.Array.data[1].subtitleText
      value: 'JEKKO: DAS IST SPIELZEITSTRECKUNG!!!'
      objectReference: {fileID: 0}
