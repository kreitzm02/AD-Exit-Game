      objectReference: {fileID: 0}
    - target: {fileID: 8334727942531066475, guid: c3b9b1aeebcb3e0438dfc54c33fc39d4, type: 3}
      propertyPath: sequences.Array.data[0].steps.Array.data[1].subtitleText
      value: 'JEKKO: Uuuh Pizza, na los hol das Geld. Teilen wir uns eine? Nein,
        nein, ich will meine Eigene! '
      objectReference: {fileID: 0}
    - target: {fileID: 8334727942531066475, guid: c3b9b1aeebcb3e0438dfc54c33fc39d4, type: 3}
      propertyPath: sequences.Array.data[0].steps.Array.data[2].subtitleText
      value: 'JEKKO: Genau, eine mit Thunfisch, Brokkoli und Sauce Hollandaise.'
      objectReference: {fileID: 0}
    - target: {fileID: 8334727942531066475, guid: c3b9b1aeebcb3e0438dfc54c33fc39d4, type: 3}
      propertyPath: sequences.Array.data[0].steps.Array.data[3].subtitleText
      value: "KARA: Was? Kannst du \xFCberhaupt essen? Und selbst wenn, was ist das
        denn f\xFCr ne Pizza? "
      objectReference: {fileID: 0}
    - target: {fileID: 8334727942531066475, guid: c3b9b1aeebcb3e0438dfc54c33fc39d4, type: 3}
      propertyPath: sequences.Array.data[0].steps.Array.data[4].subtitleText
      value: 'KARA: Du hast doch jeglichen guten Geschmack verloren!'
      objectReference: {fileID: 0}
    - target: {fileID: 8334727942531066475, guid: c3b9b1aeebcb3e0438dfc54c33fc39d4, type: 3}
      propertyPath: sequences.Array.data[0].steps.Array.data[5].subtitleText
      value: "JEKKO: Noch machst du dich \xFCber mich lustig, aber probier das mal
        selber! "
      objectReference: {fileID: 0}
    - target: {fileID: 8334727942531066475, guid: c3b9b1aeebcb3e0438dfc54c33fc39d4, type: 3}
      propertyPath: sequences.Array.data[0].steps.Array.data[6].subtitleText
      value: "JEKKO: Du wirst um Vergebung bettelnd zur\xFCck gekrochen kommen, das
        verspreche ich dir."
      objectReference: {fileID: 0}
    - target: {fileID: 8334727942531066475, guid: c3b9b1aeebcb3e0438dfc54c33fc39d4, type: 3}
      propertyPath: sequences.Array.data[0].steps.Array.data[7].subtitleText
      value: "KARA: Bestimmt, bestimmt. Es gibt nur ein kleines Problem. Ich wei\xDF
        doch nicht die Nummer vom Pizzaboten auswendig."
      objectReference: {fileID: 0}
    - target: {fileID: 8334727942531066475, guid: c3b9b1aeebcb3e0438dfc54c33fc39d4, type: 3}
      propertyPath: sequences.Array.data[0].steps.Array.data[8].subtitleText
      value: "KARA: Wir m\xFCssen erstmal die Brosch\xFCre finden, die hier irgendwo
        rumfliegt."
      objectReference: {fileID: 0}
    - target: {fileID: 8334727942531066475, guid: c3b9b1aeebcb3e0438dfc54c33fc39d4, type: 3}
      propertyPath: sequences.Array.data[0].steps.Array.data[9].subtitleText
      value: 'JEKKO: Aargh, ja dann mach aber auch! Die liegt bestimmt beim Telefon
        oder so.'
      objectReference: {fileID: 0}
    - target: {fileID: 8334727942531066475, guid: c3b9b1aeebcb3e0438dfc54c33fc39d4, type: 3}
      propertyPath: sequences.Array.data[1].steps.Array.data[0].subtitleText
      value: 'JEKKO: Uuuh Pizza, na los hol das Geld.

        Teilen wir uns eine?
        Nein, nein,

        ich will meine Eigene! '
      objectReference: {fileID: 0}
    - target: {fileID: 8334727942531066475, guid: c3b9b1aeebcb3e0438dfc54c33fc39d4, type: 3}
      propertyPath: sequences.Array.data[1].steps.Array.data[1].subtitleText
      value: "KARA: Was? Kannst du \xFCberhaupt essen?\r\nUnd selbst wenn, was ist
        das\r\ndenn f\xFCr ne Pizza? "
      objectReference: {fileID: 0}
