      propertyPath: sequences.Array.data[0].steps.Array.data[0].subtitleText
      value: "Eine Heizung. Wie spannend. Funktionieren tut sie \xFCbrigens nicht..."
      objectReference: {fileID: 0}
    - target: {fileID: 8334727942531066475, guid: c3b9b1aeebcb3e0438dfc54c33fc39d4, type: 3}
      propertyPath: sequences.Array.data[0].steps.Array.data[1].subtitleText
      value: 
      objectReference: {fileID: 0}
    - target: {fileID: 8334727942531066475, guid: c3b9b1aeebcb3e0438dfc54c33fc39d4, type: 3}
      propertyPath: sequences.Array.data[0].steps.Array.data[2].subtitleText
      value: 'JEKKO: Ja?'
      objectReference: {fileID: 0}
    - target: {fileID: 8334727942531066475, guid: c3b9b1aeebcb3e0438dfc54c33fc39d4, type: 3}
      propertyPath: sequences.Array.data[0].steps.Array.data[3].subtitleText
      value: "KARA: Ich vertraue dir nie wieder bei sowas, das wei\xDFt du, ja?"
      objectReference: {fileID: 0}
    - target: {fileID: 8334727942531066475, guid: c3b9b1aeebcb3e0438dfc54c33fc39d4, type: 3}
      propertyPath: sequences.Array.data[0].steps.Array.data[4].subtitleText
      value: "JEKKO: Ach komm, du musst zugeben, dass sie echt nicht schlecht war.
        Sonst h\xE4ttest du sie niemals aufgegessen."
      objectReference: {fileID: 0}
    - target: {fileID: 8334727942531066475, guid: c3b9b1aeebcb3e0438dfc54c33fc39d4, type: 3}
      propertyPath: sequences.Array.data[0].steps.Array.data[5].subtitleText
      value: "KARA: Ich hab diese  verdammte Pizza nur gegessen, weil die Alternative
        ein billieges, altes Bier aus dem K\xFChlschrank mit Ketchup als Beilage
        gewesen w\xE4re. Und das wei\xDFt du auch!"
      objectReference: {fileID: 0}
    - target: {fileID: 8334727942531066475, guid: c3b9b1aeebcb3e0438dfc54c33fc39d4, type: 3}
      propertyPath: sequences.Array.data[0].steps.Array.data[6].subtitleText
      value: 'JEKKO: Jaja, beharre ruhig darauf um nicht deinen Stolz zu verlieren.'
      objectReference: {fileID: 0}
    - target: {fileID: 8334727942531066475, guid: c3b9b1aeebcb3e0438dfc54c33fc39d4, type: 3}
      propertyPath: sequences.Array.data[0].steps.Array.data[7].subtitleText
      value: 
      objectReference: {fileID: 0}
