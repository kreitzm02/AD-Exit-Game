      objectReference: {fileID: 775865287}
    - target: {fileID: 8334727942531066475, guid: c3b9b1aeebcb3e0438dfc54c33fc39d4, type: 3}
      propertyPath: sequences.Array.data[0].steps.Array.data[1].subtitleText
      value: 'Jekko: Karaa... Karaa....'
      objectReference: {fileID: 0}
    - target: {fileID: 8334727942531066475, guid: c3b9b1aeebcb3e0438dfc54c33fc39d4, type: 3}
      propertyPath: sequences.Array.data[0].steps.Array.data[2].subtitleText
      value: 'Jekko: WACH AUF!!!'
      objectReference: {fileID: 0}
    - target: {fileID: 8334727942531066475, guid: c3b9b1aeebcb3e0438dfc54c33fc39d4, type: 3}
      propertyPath: sequences.Array.data[0].steps.Array.data[3].subtitleText
      value: 'Kara: Was? Was ist das? Mein Zimmer? Aber warum?'
      objectReference: {fileID: 0}
    - target: {fileID: 8334727942531066475, guid: c3b9b1aeebcb3e0438dfc54c33fc39d4, type: 3}
      propertyPath: sequences.Array.data[0].steps.Array.data[4].subtitleText
      value: 'Jekko: Hahahahahaha... Na los! Erinner dich!'
      objectReference: {fileID: 0}
    - target: {fileID: 8334727942531066475, guid: c3b9b1aeebcb3e0438dfc54c33fc39d4, type: 3}
      propertyPath: sequences.Array.data[0].steps.Array.data[5].subtitleText
      value: "Jekko: Verdr\xE4ng es doch nicht weiter!"
      objectReference: {fileID: 0}
    - target: {fileID: 8334727942531066475, guid: c3b9b1aeebcb3e0438dfc54c33fc39d4, type: 3}
      propertyPath: sequences.Array.data[0].steps.Array.data[6].subtitleText
      value: 'Jekko: Wer du bist! Und was du bist!'
      objectReference: {fileID: 0}
    - target: {fileID: 8334727942531066475, guid: c3b9b1aeebcb3e0438dfc54c33fc39d4, type: 3}
      propertyPath: sequences.Array.data[0].steps.Array.data[7].subtitleText
      value: 'Kara: Lass es sein! Ich will hier raus! Lass mich hier raus!'
      objectReference: {fileID: 0}
    - target: {fileID: 8334727942531066475, guid: c3b9b1aeebcb3e0438dfc54c33fc39d4, type: 3}
      propertyPath: sequences.Array.data[0].steps.Array.data[8].subtitleText
      value: 'Jekko: Versuch es doch! Meine Hilfe bekommst du diesmal nicht! Mal
        schauen, ob du auch alleine was hinkriegst!'
      objectReference: {fileID: 0}
    - target: {fileID: 8334727942531066475, guid: c3b9b1aeebcb3e0438dfc54c33fc39d4, type: 3}
      propertyPath: sequences.Array.data[0].steps.Array.data[9].subtitleText
      value: 'Jekko: Oder ob du dich doch nur bei anderen hochziehen kannst!'
      objectReference: {fileID: 0}
    - target: {fileID: 8334727942531066475, guid: c3b9b1aeebcb3e0438dfc54c33fc39d4, type: 3}
      propertyPath: sequences.Array.data[0].steps.Array.data[10].subtitleText
      value: 'Kara: Dann sei ruhig! Ich brauche dich doch nicht!'
      objectReference: {fileID: 0}
    - target: {fileID: 8334727942531066475, guid: c3b9b1aeebcb3e0438dfc54c33fc39d4, type: 3}
      propertyPath: sequences.Array.data[0].steps.Array.data[11].subtitleText
      value: 'Jekko: Ach ja? Ist das so? Wer von uns redet denn die ganze Zeit mit
        seinem alten Stofftier?'
      objectReference: {fileID: 0}
    - target: {fileID: 8334727942531066475, guid: c3b9b1aeebcb3e0438dfc54c33fc39d4, type: 3}
      propertyPath: sequences.Array.data[0].steps.Array.data[12].subtitleText
      value: 'Kara: Ruhe hab ich gesagt!'
      objectReference: {fileID: 0}
    - target: {fileID: 8334727942531066475, guid: c3b9b1aeebcb3e0438dfc54c33fc39d4, type: 3}
      propertyPath: sequences.Array.data[0].steps.Array.data[13].subtitleText
      value: 
      objectReference: {fileID: 0}
