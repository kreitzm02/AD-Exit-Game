    - target: {fileID: 8334727942531066475, guid: c3b9b1aeebcb3e0438dfc54c33fc39d4, type: 3}
      propertyPath: sequences.Array.data[0].steps.Array.data[0].subtitleText
      value: "Kara: Nein, nicht nochmal. Mach das es aufh\xF6rt, Jekko! Bitte! Ich
        kann es nicht mehr! Ich will das nicht mehr!"
      objectReference: {fileID: 0}
    - target: {fileID: 8334727942531066475, guid: c3b9b1aeebcb3e0438dfc54c33fc39d4, type: 3}
      propertyPath: sequences.Array.data[0].steps.Array.data[1].subtitleText
      value: "Kara: Ich bin das Monster! Ja von mir aus. Aber bitte, mach dass es
        aufh\xF6rt. Ich halt das alles nicht mehr aus!"
      objectReference: {fileID: 0}
    - target: {fileID: 8334727942531066475, guid: c3b9b1aeebcb3e0438dfc54c33fc39d4, type: 3}
