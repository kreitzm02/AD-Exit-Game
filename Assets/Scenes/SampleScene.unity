      objectReference: {fileID: 11400000, guid: 58c86a98b4189444c81a5fd09ed2ee45, type: 2}
    - target: {fileID: 4923332934719268576, guid: 1b90ee29d4f8f48408452ced94754ffd, type: 3}
      propertyPath: slots.Array.data[4].readableIcon
      value: 
      objectReference: {fileID: 1266715986469135529, guid: d39f923bf8a5c8c4fa9ad591a4b4e85f, type: 3}
    - target: {fileID: 4923332934719268576, guid: 1b90ee29d4f8f48408452ced94754ffd, type: 3}
      propertyPath: slots.Array.data[4].readableMode
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 4923332934719268576, guid: 1b90ee29d4f8f48408452ced94754ffd, type: 3}
      propertyPath: slots.Array.data[4].readableFullText
      value: "27. Juni 2009\n\r\nPapa hat mir mein Schloss f\xFCr das Tagebuch gekauft.
        Heute war Papa irgendwie still. Er hat zwar, als wir zusammen im Baumarkt
        waren und wir die kleinen Scharniere und das kleine Schloss gekauft haben,
        mich mehrmals gefragt, ob ich mir sicher sei, dass ich dieses Schloss wirklich
        m\xF6chte. Doch nach mehrfachem versichern, dass ich dieses Schloss wirklich
        m\xF6chte, hat er nachgegeben. Sonst war er aber wirklich.. ruhig. Aber irgendwie
        traurig ruhig. Er hat mich mit einem Blick angesehen, den ich noch nie bei
        ihm gesehen habe. Als h\xE4tte er Mitleid mit mir, ohne die Kraft zu haben,
        mir das\r\nsagen zu k\xF6nnen. Ich hab heute wieder alleine in meinem Zimmer
        gegessen. Papa hat mir eine gute Nacht gew\xFCnscht."
      objectReference: {fileID: 0}
