    - target: {fileID: 8334727942531066475, guid: c3b9b1aeebcb3e0438dfc54c33fc39d4, type: 3}
      propertyPath: sequences.Array.data[0].steps.Array.data[0].subtitleText
      value: 'Kara: Hey es passt. Aber..es sieht falsch aus. So als, ob es ein Bild
        ergeben soll. Ich krieg es aber nicht bewegt'
      objectReference: {fileID: 0}
    - target: {fileID: 8334727942531066475, guid: c3b9b1aeebcb3e0438dfc54c33fc39d4, type: 3}
      propertyPath: sequences.Array.data[0].steps.Array.data[1].subtitleText
      value: "Kara: Nein, da fehlt noch was. Ich muss die Scherben irgendwie bewegen
        k\xF6nnen."
      objectReference: {fileID: 0}
    - target: {fileID: 8334727942531066475, guid: c3b9b1aeebcb3e0438dfc54c33fc39d4, type: 3}
      propertyPath: sequences.Array.data[0].steps.Array.data[2].subtitleText
      value: 'Kara: Ruhe jetzt! In dem Zustand bist du mir eh keine Hilfe.'
      objectReference: {fileID: 0}
    - target: {fileID: 8334727942531066475, guid: c3b9b1aeebcb3e0438dfc54c33fc39d4, type: 3}
