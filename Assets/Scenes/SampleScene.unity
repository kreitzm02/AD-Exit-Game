      propertyPath: slots.Array.data[4].readableCharLimitPerPage
      value: 450
      objectReference: {fileID: 0}
    - target: {fileID: 4923332934719268576, guid: 1b90ee29d4f8f48408452ced94754ffd, type: 3}
      propertyPath: slots.Array.data[2].readablePages.Array.data[0].text
      value: 'esistmeineschuld

        esistmeineschuld

        esistmeineschuld

        esistmeineschuld

        esistmeineschuld

        esistmeineschuld

        esistmeineschuldesistmeineschuld'
      objectReference: {fileID: 0}
