    - target: {fileID: 4923332934719268576, guid: 1b90ee29d4f8f48408452ced94754ffd, type: 3}
      propertyPath: slots.Array.data[1].readableFullText
      value: "He. eute 2day\n\r\nistesmeineschuld?derdruckhatmicherdr\xFCckt!Ichbinverr\xFCckt,\r\nhalloverr\xFCcktichbinpapa.\r\nPapa?Papa?Papa?Papa?Papa?Papa?Papa?Papa?Papa?Papa?Papa?Papa?\r\nPapa?Papa?Papa?Papa?Papa?Papa?Papa?Papa?Papa?Papa?Papa?Papa?\r\nPapa?Papa?Papa?Papa?Papa?Papa?Papa?Papa?Papa?Papa?Papa?Papa?\r\nPapa?Papa?Papa?Papa?Papa?Papa?Papa?Papa?Papa?Papa?Papa?Papa?\r\nPapa?Papa?Papa?Papa?Papa?Papa?Papa?Papa?Papa?Papa?Papa?Papa?\r\nPapa?Papa?Papa?Papa?Papa?Papa?Papa?Papa?Papa?Papa?Papa?Papa?\r\nPapa?Papa?Papa?Papa?Papa?Papa?Papa?\r\nWas
        ist Papa? Papa ist ein Synonym f\xFCr Vater. V\xE4ter sind\r\nEltern. Aber
        sind leibliche V\xE4ter wirklich Papas? Sind Papas\r\nPapas, auch wenn sie
        nicht das tun, was andere Papas machen?\r\nSind Papas Papas, wenn sie einem
        nur b\xF6ses wollen? Sind\r\nPapas Papas, wenn sie einem egal sind? Ich habe
        einen Vater,\r\naber keinen Papa. Ich hatte so etwas wie einen Papa, aber\r\nder
        ist weg. Weg. Weg.WEg.wEg.weG.WeG.weG. Weg mich auf,\r\ndass ist ein Traum."
      objectReference: {fileID: 0}
