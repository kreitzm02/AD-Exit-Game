    - target: {fileID: 4923332934719268576, guid: 1b90ee29d4f8f48408452ced94754ffd, type: 3}
      propertyPath: slots.Array.data[1].item
      value: 
      objectReference: {fileID: 0}
    - target: {fileID: 4923332934719268576, guid: 1b90ee29d4f8f48408452ced94754ffd, type: 3}
      propertyPath: slots.Array.data[2].readableIcon
      value: 
      objectReference: {fileID: 1266715986469135529, guid: d39f923bf8a5c8c4fa9ad591a4b4e85f, type: 3}
    - target: {fileID: 4923332934719268576, guid: 1b90ee29d4f8f48408452ced94754ffd, type: 3}
      propertyPath: slots.Array.data[2].readableMode
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 4923332934719268576, guid: 1b90ee29d4f8f48408452ced94754ffd, type: 3}
      propertyPath: slots.Array.data[2].readableFullText
      value: "Yesterday all my troubles seemed so far away\n\r\nAufwecken? Das ist
        ein Traum? Nein! Du kannst blo\xDF Traum und Realit\xE4t nicht unterscheiden!
        Wann war das letzte Mal etwas Real? Wann nicht? Bin ich real, bist du real?
        Realit\xE4t ist ein Konstrukt. F\xFCr dich ist was anderes real, als f\xFCr
        mich. Wir formen unsere Realit\xE4t. Ich forme meine Realit\xE4t. Realit\xE4t
        ist das, was ich real haben will. Was will ich? Ich\u2026ich wei\xDF nicht
        was ich will. Ruhe? Frieden? Egal wie ruhig es ist, mein Kopf schreit! Du
        denkst, man kann seine Realit\xE4t nicht formen? Was ist\r\ndenn Realit\xE4t?
        Die eigene Realit\xE4t, sind Informationen, die man hat. Oder eben nicht
        hat. Wer wei\xDF, vielleicht forme ich deine Realit\xE4t mehr als du denkst?
        Hast du Verst\xE4ndnis? Hast du Mitgef\xFChl? Du wei\xDFt doch gar nicht,
        was passiert ist? So weit sind wir doch noch gar nicht! Ich wei\xDF es auch
        nicht, sagst du? Tja, wer wei\xDF, wer wei\xDF? Blindes Vertrauen kann stark
        ausgenutzt werden. Vielleicht verf\xE4lsche ich Informationen? Vielleicht
        lasse ich welche aus? Tageb\xFCcher? Seit wann schreibe ich Tageb\xFCcher?
        Habe ich je welche geschrieben? Ich kann mich nicht erinnern! Siehst du,
        wie leicht du zu verunsichern bist? Schon wei\xDFt du nicht mehr, was du
        glauben sollst! Kleiner Spa\xDF hihi"
      objectReference: {fileID: 0}
