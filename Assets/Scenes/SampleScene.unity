      value: 
      objectReference: {fileID: 11400000, guid: 945eb17ab40a7c94b8271fadce9cb8bb, type: 2}
    - target: {fileID: 4923332934719268576, guid: 1b90ee29d4f8f48408452ced94754ffd, type: 3}
      propertyPath: slots.Array.data[5].item
      value: 
      objectReference: {fileID: 0}
    - target: {fileID: 4923332934719268576, guid: 1b90ee29d4f8f48408452ced94754ffd, type: 3}
      propertyPath: slots.Array.data[2].readableIcon
      value: 
      objectReference: {fileID: 0}
    - target: {fileID: 4923332934719268576, guid: 1b90ee29d4f8f48408452ced94754ffd, type: 3}
      propertyPath: slots.Array.data[3].readableIcon
      value: 
      objectReference: {fileID: 0}
    - target: {fileID: 4923332934719268576, guid: 1b90ee29d4f8f48408452ced94754ffd, type: 3}
      propertyPath: slots.Array.data[4].readableIcon
      value: 
      objectReference: {fileID: 1266715986469135529, guid: d39f923bf8a5c8c4fa9ad591a4b4e85f, type: 3}
    - target: {fileID: 4923332934719268576, guid: 1b90ee29d4f8f48408452ced94754ffd, type: 3}
      propertyPath: slots.Array.data[2].readablePages.Array.size
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 4923332934719268576, guid: 1b90ee29d4f8f48408452ced94754ffd, type: 3}
      propertyPath: slots.Array.data[3].readablePages.Array.size
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 4923332934719268576, guid: 1b90ee29d4f8f48408452ced94754ffd, type: 3}
      propertyPath: slots.Array.data[4].readablePages.Array.size
      value: 4
      objectReference: {fileID: 0}
    - target: {fileID: 4923332934719268576, guid: 1b90ee29d4f8f48408452ced94754ffd, type: 3}
      propertyPath: slots.Array.data[2].readablePages.Array.data[0].text
      value: "Vielleicht ist das ihre Art sich einzugestehen, dass sie etwas falsch
        gemacht hat, vielleicht ist das ihre Art zu verdr\xE4ngen, dass sie etwas
        falsch gemacht hat. Heute wollte ich das aber nicht einfach nur hinnehmen.
        Ich hab Mama gefragt, warum sie die Hand gehoben hat und mich schlagen wollte.
        Warum sie mich angeschrien hat. Ich wollte eine Reaktion. Ich wollte einfach
        wissen, warum sie manchmal ist, wie sie ist."
      objectReference: {fileID: 0}
    - target: {fileID: 4923332934719268576, guid: 1b90ee29d4f8f48408452ced94754ffd, type: 3}
      propertyPath: slots.Array.data[2].readablePages.Array.data[1].text
      value: "Mama hat mich komisch angeguckt, als ich das gefragt hab. Sie hat gesagt,
        dass das nie passiert ist, dass sie nie die Hand gehoben h\xE4tte, mich nie
        schlagen h\xE4tte wollen. Sie hat nicht geschrien, aber ruhig hat sie auch
        nicht gesprochen. Sie war einfach unruhig, als h\xE4tte Mama niemals damit
        gerechnet, dass ich nicht auch so tue, als w\xE4re nichts gewesen."
      objectReference: {fileID: 0}
    - target: {fileID: 4923332934719268576, guid: 1b90ee29d4f8f48408452ced94754ffd, type: 3}
      propertyPath: slots.Array.data[2].readablePages.Array.data[2].text
      value: "Ich hab Mama gesagt, dass sie l\xFCgt, dass sie mich wohl schlagen
        wollte. Pl\xF6tzlich hat Mama angefangen mich anzuschreien. Ich w\xFCrde
        mich immer als Opfer darstellen, dass sie ja die schlimmste Mutter der Welt
        w\xE4re und alles nur falsch machen w\xFCrde. Dass sie bei mir und meiner
        Erziehung alles falsch gemacht hat und dass ich ein undankbares, freches
        Kind sei."
      objectReference: {fileID: 0}
    - target: {fileID: 4923332934719268576, guid: 1b90ee29d4f8f48408452ced94754ffd, type: 3}
      propertyPath: slots.Array.data[2].readablePages.Array.data[3].text
      value: "Ich hab Mama gesagt, dass sie l\xFCgt, dass sie mich wohl schlagen
        wollte. Pl\xF6tzlich hat Mama angefangen mich anzuschreien. Ich w\xFCrde
        mich immer als Opfer darstellen, dass sie ja die schlimmste Mutter der Welt
        w\xE4re und alles nur falsch machen w\xFCrde. Dass sie bei mir und meiner
        Erziehung alles falsch gemacht hat und dass ich ein undankbares, freches
        Kind sei."
      objectReference: {fileID: 0}
    - target: {fileID: 4923332934719268576, guid: 1b90ee29d4f8f48408452ced94754ffd, type: 3}
      propertyPath: slots.Array.data[3].readablePages.Array.data[0].text
      value: "Ich hab nur eine 3 in Mathe, in allen anderen F\xE4chern hab ich eine
        2, in Englisch und Kunst sogar eine 1. Mama hat auch die letzten Tage so
        getan, als w\xE4re nichts passiert. Es ist alles wieder zum Normalzustand
        zur\xFCck. Glaub ich jedenfalls. Papa ist mit mir als Belohnung in die Stadt
        gefahren und ich durfte mir im Spielzeugladen doch noch ein Raumschiff und
        eine kleine Stoffkatze aussuchen."
      objectReference: {fileID: 0}
    - target: {fileID: 4923332934719268576, guid: 1b90ee29d4f8f48408452ced94754ffd, type: 3}
      propertyPath: slots.Array.data[3].readablePages.Array.data[1].text
      value: "Als wir nach Hause gefahren sind, hat Mama in der Haust\xFCr auf mich
        gewartet. Sie hat sich mein Zeugnis angeguckt und mir gesagt, wie stolz sie
        auf mich ist und wie stolz sie ist, dass ich ihr Sohn sei. Daraufhin hat
        sie mich umarmt. Abends sind wir sogar zusammen ins Restaurant gegangen und
        ich habe Schnitzel mit Pommes bestellt."
      objectReference: {fileID: 0}
    - target: {fileID: 4923332934719268576, guid: 1b90ee29d4f8f48408452ced94754ffd, type: 3}
      propertyPath: slots.Array.data[3].readablePages.Array.data[2].text
      value: "Als wir nach Hause gefahren sind, hat Mama in der Haust\xFCr auf mich
        gewartet. Sie hat sich mein Zeugnis angeguckt und mir gesagt, wie stolz sie
        auf mich ist und wie stolz sie ist, dass ich ihr Sohn sei. Daraufhin hat
        sie mich umarmt. Abends sind wir sogar zusammen ins Restaurant gegangen und
        ich habe Schnitzel mit Pommes bestellt."
      objectReference: {fileID: 0}
    - target: {fileID: 4923332934719268576, guid: 1b90ee29d4f8f48408452ced94754ffd, type: 3}
      propertyPath: slots.Array.data[3].readablePages.Array.data[3].text
      value: "Als wir nach Hause gefahren sind, hat Mama in der Haust\xFCr auf mich
        gewartet. Sie hat sich mein Zeugnis angeguckt und mir gesagt, wie stolz sie
        auf mich ist und wie stolz sie ist, dass ich ihr Sohn sei. Daraufhin hat
        sie mich umarmt. Abends sind wir sogar zusammen ins Restaurant gegangen und
        ich habe Schnitzel mit Pommes bestellt."
      objectReference: {fileID: 0}
    - target: {fileID: 4923332934719268576, guid: 1b90ee29d4f8f48408452ced94754ffd, type: 3}
      propertyPath: slots.Array.data[4].readablePages.Array.data[0].text
      value: "4. Juli 2009\n\nWir sind heute nicht nach Spanien geflogen. Mama ist
        seit gestern weg und ich wei\xDF nicht wohin. Papa wei\xDF es auch nicht,
        sagt er zumindest. Ich glaub Mama kommt nicht mehr wieder."
      objectReference: {fileID: 0}
    - target: {fileID: 4923332934719268576, guid: 1b90ee29d4f8f48408452ced94754ffd, type: 3}
      propertyPath: slots.Array.data[4].readablePages.Array.data[1].text
      value: "18. Juli 2009\n\nHeute ist Mamas Geburtstag. Es ist irgendwie seltsam,
        dass es einfach nur noch ein Tag wie jeder andere ist, seitdem sie weg ist.
        Ich hatte eine kleine Hoffnung, dass sie heute pl\xF6tzlich wieder da ist.
        Als w\xE4re nie etwas geschehen. Aber sie war trotzdem weg. Soll ich Mama
        vergessen? Soll ich so tun, als h\xE4tte sie nie existiert? "
      objectReference: {fileID: 0}
    - target: {fileID: 4923332934719268576, guid: 1b90ee29d4f8f48408452ced94754ffd, type: 3}
      propertyPath: slots.Array.data[4].readablePages.Array.data[2].text
      value: "Es schmerzt daran zu denken, dass ich sie vielleicht nie wieder sehen
        werde. Selbst wenn, ich sie vergessen wollen w\xFCrde, ist es fast unm\xF6glich,
        weil alles um mich herum, mich an sie erinnert. Die Sofakissen riechen noch
        ein wenig nach ihr, auch wenn das vermutlich nicht mehr lange anh\xE4lt.
        Aber selbst wenn der Geruch dann irgendwann verschwunden ist, "
      objectReference: {fileID: 0}
    - target: {fileID: 4923332934719268576, guid: 1b90ee29d4f8f48408452ced94754ffd, type: 3}
      propertyPath: slots.Array.data[4].readablePages.Array.data[3].text
      value: "so haben trotzdem alle Passw\xF6rter und Zahlenschl\xF6sser ihr Geburtsdatum
        als Kombination. So als w\xFCrde man mich zwingen, dass ich nicht vergessen
        darf. Ich hoffe, dass es mir bald leichter f\xE4llt, ohne Mama klar zu kommen.
        Ich habe ja immerhin noch Papa."
      objectReference: {fileID: 0}
    - target: {fileID: 8339423539369142506, guid: 1b90ee29d4f8f48408452ced94754ffd, type: 3}
      propertyPath: m_LocalPosition.x
      value: -5.45
      objectReference: {fileID: 0}
    - target: {fileID: 8339423539369142506, guid: 1b90ee29d4f8f48408452ced94754ffd, type: 3}
