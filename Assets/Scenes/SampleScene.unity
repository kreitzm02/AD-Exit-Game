    - target: {fileID: 8334727942531066475, guid: c3b9b1aeebcb3e0438dfc54c33fc39d4, type: 3}
      propertyPath: sequences.Array.data[0].steps.Array.data[2].subtitleText
      value: "Jekko: Tja, viel Gl\xFCck dabei. Der Keller ist jetzt deine pers\xF6nliche
        H\xF6llenkammer."
      objectReference: {fileID: 0}
    - target: {fileID: 8334727942531066475, guid: c3b9b1aeebcb3e0438dfc54c33fc39d4, type: 3}
      propertyPath: sequences.Array.data[0].steps.Array.data[3].subtitleText
      value: 'Kara: Was? Das ist doch nicht real? Nichts davon ist real!'
      objectReference: {fileID: 0}
    - target: {fileID: 8334727942531066475, guid: c3b9b1aeebcb3e0438dfc54c33fc39d4, type: 3}
      propertyPath: sequences.Array.data[0].steps.Array.data[4].subtitleText
      value: 'Jekko: Jahaa, stimmt, ist es auch nicht. '
      objectReference: {fileID: 0}
    - target: {fileID: 8334727942531066475, guid: c3b9b1aeebcb3e0438dfc54c33fc39d4, type: 3}
      propertyPath: sequences.Array.data[0].steps.Array.data[5].subtitleText
      value: "Jekko: Aber das muss es auch nicht sein, solange es f\xFCr dich real
        ist."
      objectReference: {fileID: 0}
    - target: {fileID: 8334727942531066475, guid: c3b9b1aeebcb3e0438dfc54c33fc39d4, type: 3}
      propertyPath: sequences.Array.data[0].steps.Array.data[6].subtitleText
      value: "Jekko: Also bitte, ich habe das Gef\xFChl mich zu wiederholen, aber
        DU REDEST IMMER NOCH MIT EINEM STOFFTIER!"
      objectReference: {fileID: 0}
    - target: {fileID: 8334727942531066475, guid: c3b9b1aeebcb3e0438dfc54c33fc39d4, type: 3}
      propertyPath: sequences.Array.data[0].steps.Array.data[7].subtitleText
      value: "Jekko: Hier ist schon lange nichts mehr real. Aber es macht so langsam
        endlich Spa\xDF. Dein Unterbewusstsein knickt endlich ein."
      objectReference: {fileID: 0}
    - target: {fileID: 8334727942531066475, guid: c3b9b1aeebcb3e0438dfc54c33fc39d4, type: 3}
      propertyPath: sequences.Array.data[0].steps.Array.data[8].subtitleText
      value: "Jekko: Du siehst Dinge die du nicht sehen solltest. NICHT SEHEN M\xD6CHTEST."
      objectReference: {fileID: 0}
    - target: {fileID: 8334727942531066475, guid: c3b9b1aeebcb3e0438dfc54c33fc39d4, type: 3}
      propertyPath: sequences.Array.data[0].steps.Array.data[9].subtitleText
      value: "Jekko: \"Erinnere dich\" ist keine Aufforderung oder Bitte. Es ist
        eine unausweichliche Drohung! Du gibst dir so viel M\xFChe zu vergessen und
        zu verdr\xE4ngen..."
      objectReference: {fileID: 0}
    - target: {fileID: 8334727942531066475, guid: c3b9b1aeebcb3e0438dfc54c33fc39d4, type: 3}
      propertyPath: sequences.Array.data[1].steps.Array.data[0].subtitleText
      value: '[ NO TEXT - CHEST OPEN SFX]'
      objectReference: {fileID: 0}
    - target: {fileID: 8334727942531066475, guid: c3b9b1aeebcb3e0438dfc54c33fc39d4, type: 3}
      propertyPath: sequences.Array.data[1].steps.Array.data[1].subtitleText
      value: "JEKKO: (ironisch)Ich w\xFCrd dir ja raten,\r\nmach nen Arzttermin.
        Aber selbst\r\ndas w\xFCrdest du wohl vergessen"
      objectReference: {fileID: 0}
    - target: {fileID: 8334727942531066475, guid: c3b9b1aeebcb3e0438dfc54c33fc39d4, type: 3}
      propertyPath: sequences.Array.data[2].steps.Array.data[0].subtitleText
      value: '[ NO TEXT - CHEST OPEN SFX]'
      objectReference: {fileID: 0}
    - target: {fileID: 8334727942531066475, guid: c3b9b1aeebcb3e0438dfc54c33fc39d4, type: 3}
      propertyPath: sequences.Array.data[2].steps.Array.data[1].subtitleText
      value: "JEKKO: (ironisch)Ich w\xFCrd dir ja raten,\r\nmach nen Arzttermin.
        Aber selbst\r\ndas w\xFCrdest du wohl vergessen"
      objectReference: {fileID: 0}
    - target: {fileID: 8334727942531066475, guid: c3b9b1aeebcb3e0438dfc54c33fc39d4, type: 3}
      propertyPath: sequences.Array.data[3].steps.Array.data[0].subtitleText
      value: '[ NO TEXT - CHEST OPEN SFX]'
      objectReference: {fileID: 0}
    - target: {fileID: 8334727942531066475, guid: c3b9b1aeebcb3e0438dfc54c33fc39d4, type: 3}
      propertyPath: sequences.Array.data[3].steps.Array.data[1].subtitleText
      value: 'JEKKO: DAS IST SPIELZEITSTRECKUNG!!!'
      objectReference: {fileID: 0}
    - target: {fileID: 8334727942531066475, guid: c3b9b1aeebcb3e0438dfc54c33fc39d4, type: 3}
      propertyPath: sequences.Array.data[4].steps.Array.data[0].subtitleText
      value: '[ NO TEXT - CHEST OPEN SFX]'
      objectReference: {fileID: 0}
    - target: {fileID: 8334727942531066475, guid: c3b9b1aeebcb3e0438dfc54c33fc39d4, type: 3}
      propertyPath: sequences.Array.data[4].steps.Array.data[1].subtitleText
      value: 'JEKKO: DAS IST SPIELZEITSTRECKUNG!!!'
      objectReference: {fileID: 0}
    - target: {fileID: 8334727942531066475, guid: c3b9b1aeebcb3e0438dfc54c33fc39d4, type: 3}
      propertyPath: sequences.Array.data[0].steps.Array.data[10].subtitleText
      value: "Jekko: Aber dein Kopf ist ein Akku, der dir dauerhaft eine Realit\xE4t
        vorspielt. Und alles in diesem Haus ist der Bunsenbrenner, der den Akku langsam
        aber sicher zum Platzen bringt,"
      objectReference: {fileID: 0}
    - target: {fileID: 8334727942531066475, guid: c3b9b1aeebcb3e0438dfc54c33fc39d4, type: 3}
      propertyPath: sequences.Array.data[0].steps.Array.data[11].subtitleText
      value: 'Jekko: wodurch alles, was du nicht sehen willst langsam hinaus quirlt!'
      objectReference: {fileID: 0}
    - target: {fileID: 8334727942531066475, guid: c3b9b1aeebcb3e0438dfc54c33fc39d4, type: 3}
      propertyPath: sequences.Array.data[0].steps.Array.data[12].subtitleText
      value: 'Kara: Ruhe jetzt Jekko! Wenn du eh nur in meinem Kopf bist, dann sei
        ruhig! '
      objectReference: {fileID: 0}
    - target: {fileID: 8334727942531066475, guid: c3b9b1aeebcb3e0438dfc54c33fc39d4, type: 3}
      propertyPath: sequences.Array.data[0].steps.Array.data[13].subtitleText
      value: 'Kara: Ich will hier raus! Und ich schaffe es auch hier raus.'
      objectReference: {fileID: 0}
    - target: {fileID: 8334727942531066475, guid: c3b9b1aeebcb3e0438dfc54c33fc39d4, type: 3}
      propertyPath: sequences.Array.data[0].steps.Array.data[14].subtitleText
      value: 'Jekko: Ja bestimmt tust du das, Kara. Ich gehe sogar davon aus!'
      objectReference: {fileID: 0}
    - target: {fileID: 8334727942531066475, guid: c3b9b1aeebcb3e0438dfc54c33fc39d4, type: 3}
      propertyPath: sequences.Array.data[0].steps.Array.data[15].subtitleText
      value: "Jekko: Aber wo ich eh dabei war mich zu wiederholen, w\xFCrde ich es
        doch nur zu gern erneut tun. "
      objectReference: {fileID: 0}
    - target: {fileID: 8334727942531066475, guid: c3b9b1aeebcb3e0438dfc54c33fc39d4, type: 3}
      propertyPath: sequences.Array.data[0].steps.Array.data[16].subtitleText
      value: "Jekko: Ich frage mich, was zuerst kommt. Die Erinnerung oder die L\xF6sung,
        nahahaha!"
      objectReference: {fileID: 0}
    - target: {fileID: 8334727942531066475, guid: c3b9b1aeebcb3e0438dfc54c33fc39d4, type: 3}
