    - target: {fileID: 8334727942531066475, guid: c3b9b1aeebcb3e0438dfc54c33fc39d4, type: 3}
      propertyPath: sequences.Array.data[0].steps.Array.data[0].subtitleText
      value: 'Kara: Oah... was?'
      objectReference: {fileID: 0}
    - target: {fileID: 8334727942531066475, guid: c3b9b1aeebcb3e0438dfc54c33fc39d4, type: 3}
      propertyPath: sequences.Array.data[0].steps.Array.data[10].focusTarget
      value: 
      objectReference: {fileID: 775865287}
    - target: {fileID: 8334727942531066475, guid: c3b9b1aeebcb3e0438dfc54c33fc39d4, type: 3}
      propertyPath: sequences.Array.data[0].steps.Array.data[11].focusTarget
      value: 
      objectReference: {fileID: 777181378}
    - target: {fileID: 8334727942531066475, guid: c3b9b1aeebcb3e0438dfc54c33fc39d4, type: 3}
      propertyPath: sequences.Array.data[0].steps.Array.data[1].subtitleText
      value: 
      objectReference: {fileID: 0}
    - target: {fileID: 8334727942531066475, guid: c3b9b1aeebcb3e0438dfc54c33fc39d4, type: 3}
      propertyPath: sequences.Array.data[0].steps.Array.data[2].subtitleText
      value: 'Jekko: Kara! Du bist wieder wach! Ist alles in Ordnung?'
      objectReference: {fileID: 0}
    - target: {fileID: 8334727942531066475, guid: c3b9b1aeebcb3e0438dfc54c33fc39d4, type: 3}
      propertyPath: sequences.Array.data[0].steps.Array.data[3].subtitleText
      value: "Kara: Ich glaube schon, ich wei\xDF es nicht. Alles hat sich so surreal
        angef\xFChlt. So echt... ?"
      objectReference: {fileID: 0}
    - target: {fileID: 8334727942531066475, guid: c3b9b1aeebcb3e0438dfc54c33fc39d4, type: 3}
      propertyPath: sequences.Array.data[0].steps.Array.data[4].subtitleText
      value: "Jekko: H\xE4 was? Was hat sich echt angef\xFChlt? Und woher hast du
        den kaputten Schl\xFCssel?"
      objectReference: {fileID: 0}
    - target: {fileID: 8334727942531066475, guid: c3b9b1aeebcb3e0438dfc54c33fc39d4, type: 3}
      propertyPath: sequences.Array.data[0].steps.Array.data[5].subtitleText
      value: "Kara: Kaputter Schl\xFCssel? Was meinst.. moment mal. Du hast Recht."
      objectReference: {fileID: 0}
    - target: {fileID: 8334727942531066475, guid: c3b9b1aeebcb3e0438dfc54c33fc39d4, type: 3}
      propertyPath: sequences.Array.data[0].steps.Array.data[6].subtitleText
      value: "Kara: Das ist der Schl\xFCssel f\xFCr das Zimmer meines Vaters. Wir
        m\xFCssen ihn aber irgendwie wieder ganz kriegen."
      objectReference: {fileID: 0}
    - target: {fileID: 8334727942531066475, guid: c3b9b1aeebcb3e0438dfc54c33fc39d4, type: 3}
      propertyPath: sequences.Array.data[0].steps.Array.data[7].subtitleText
      value: "Jekko: Warte, warte. Du hattest den Schl\xFCssel also die ganze Zeit
        dabei?"
      objectReference: {fileID: 0}
    - target: {fileID: 8334727942531066475, guid: c3b9b1aeebcb3e0438dfc54c33fc39d4, type: 3}
      propertyPath: sequences.Array.data[0].steps.Array.data[8].subtitleText
      value: 'Kara: Was? Nein... Ich habe ihn... gefunden...'
      objectReference: {fileID: 0}
    - target: {fileID: 8334727942531066475, guid: c3b9b1aeebcb3e0438dfc54c33fc39d4, type: 3}
      propertyPath: sequences.Array.data[0].steps.Array.data[9].subtitleText
      value: "Jekko: Gefunden? Wo denn bitte? Lag er zuf\xE4llig auf dem Boden und
        du bist drauf gefallen, wodurch er in seine Einzelteile zersplittert ist?"
      objectReference: {fileID: 0}
    - target: {fileID: 8334727942531066475, guid: c3b9b1aeebcb3e0438dfc54c33fc39d4, type: 3}
      propertyPath: sequences.Array.data[0].steps.Array.data[10].subtitleText
      value: "Kara: Nein? Ach ich hab doch keine Ahnung. Jedenfalls m\xFCssen wir
        jetzt irgend eine Art von Kleber f\xFCr den Schl\xFCssel finden."
      objectReference: {fileID: 0}
    - target: {fileID: 8334727942531066475, guid: c3b9b1aeebcb3e0438dfc54c33fc39d4, type: 3}
      propertyPath: sequences.Array.data[0].steps.Array.data[11].subtitleText
      value: "Jekko: Hast du schonmal im Bad von deinem Vater nachgesehen? Vielleicht
        ist da ja was n\xFCtzliches?"
      objectReference: {fileID: 0}
    - target: {fileID: 8334727942531066475, guid: c3b9b1aeebcb3e0438dfc54c33fc39d4, type: 3}
      propertyPath: sequences.Array.data[0].steps.Array.data[12].subtitleText
      value: 
      objectReference: {fileID: 0}
