      objectReference: {fileID: 11400000, guid: 94526d07a05440949ae36d782c9caa04, type: 2}
    - target: {fileID: 4923332934719268576, guid: 1b90ee29d4f8f48408452ced94754ffd, type: 3}
      propertyPath: slots.Array.data[0].readableIcon
      value: 
      objectReference: {fileID: 1266715986469135529, guid: d39f923bf8a5c8c4fa9ad591a4b4e85f, type: 3}
    - target: {fileID: 4923332934719268576, guid: 1b90ee29d4f8f48408452ced94754ffd, type: 3}
      propertyPath: slots.Array.data[0].readableMode
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 4923332934719268576, guid: 1b90ee29d4f8f48408452ced94754ffd, type: 3}
      propertyPath: slots.Array.data[0].readableFullText
      value: "22. Juni 2009 \n\nMama hat mich heute von der Schule abgeholt. Sie
        hat mich gefragt, ob ich mich denn schon auf die Sommerferien freue und ich
        hab ja gesagt. Sie meinte, dass wir auch f\xFCr eine Woche zusammen nach
        Spanien fliegen w\xFCrden. Mein letzter Flug ist bestimmt 2 oder 3 Jahre
        her, deshalb bin ich ein bisschen nerv\xF6s, aber als ich das zu Mama gesagt
        hab, meinte sie nur, dass ich mich nicht so anstellen soll. Mama hat mich
        au\xDFerdem gefragt, wie ich denn mein neues Tagebuch finde und ob ich denn
        auch viel schreibe. Als ich mit ja antwortete, hat sie mich gefragt, ob sie
        das mal lesen d\xFCrfte. Ich hab ihr gesagt, dass niemand das Lesen darf,
        au\xDFer mir. Danach war sie den Rest der Fahrt sehr ruhig."
      objectReference: {fileID: 0}
    - target: {fileID: 4923332934719268576, guid: 1b90ee29d4f8f48408452ced94754ffd, type: 3}
      propertyPath: slots.Array.data[0].readableCharLimitPerPage
      value: 450
      objectReference: {fileID: 0}
    - target: {fileID: 4923332934719268576, guid: 1b90ee29d4f8f48408452ced94754ffd, type: 3}
      propertyPath: slots.Array.data[0].readablePages.Array.size
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 4923332934719268576, guid: 1b90ee29d4f8f48408452ced94754ffd, type: 3}
      propertyPath: slots.Array.data[0].readablePages.Array.data[0].text
      value: 
      objectReference: {fileID: 0}
    - target: {fileID: 4923332934719268576, guid: 1b90ee29d4f8f48408452ced94754ffd, type: 3}
      propertyPath: slots.Array.data[0].readablePages.Array.data[1].text
      value: "wodurch sich der Unterricht nicht so stark zieht.  Ich habs vermisst
        neben meinen Freunden zu sitzen. Davor musste ich ein halbes Jahr neben Torben
        sitzen und den mag ich nicht. Torben hat sich immer nur \xFCber mich lustig
        gemacht, weil ich als Junge mit Leonie befreundet bin. Ich versteh wirklich
        sein Problem damit nicht, dass ich Jungs und M\xE4dchen mag, aber Torben
        ist nun mal ein Idiot. Immerhin sitzt er jetzt in der"
      objectReference: {fileID: 0}
    - target: {fileID: 4923332934719268576, guid: 1b90ee29d4f8f48408452ced94754ffd, type: 3}
      propertyPath: slots.Array.data[0].readablePages.Array.data[2].text
      value: "Selbstverst\xE4ndlich hab ich sofort ja gesagt und er hat mir versprochen,
        dass wir ihn morgen Abend zusammen gucken. Komischerweise hat Papa mich auch
        gefragt, ob Mama mal mein Tagebuch lesen d\xFCrfte. Mama soll wohl zu ihm
        gegangen sein und ihn gefragt haben, ob er mich mal fragen k\xF6nnte. ich
        hab auch Papa gesagt, dass ich nicht m\xF6chte, dass irgendjemand mein Tagebuch
        liest, weil ich das f\xFCr mich schreibe,"
      objectReference: {fileID: 0}
    - target: {fileID: 4923332934719268576, guid: 1b90ee29d4f8f48408452ced94754ffd, type: 3}
      propertyPath: slots.Array.data[0].readablePages.Array.data[3].text
      value: " Ich wei\xDF nicht, warum Mama so neugierig ist. Ich wei\xDF nicht,
        wann ich sie das letzte Mal so interessiert an meinen Hobbys gesehen habe."
      objectReference: {fileID: 0}
    - target: {fileID: 4923332934719268576, guid: 1b90ee29d4f8f48408452ced94754ffd, type: 3}
      propertyPath: slots.Array.data[0].readablePages.Array.data[4].text
      value: " Ich wei\xDF nicht, warum Mama so neugierig ist. Ich wei\xDF nicht,
        wann ich sie das letzte Mal so interessiert an meinen Hobbys gesehen habe."
      objectReference: {fileID: 0}
