      propertyPath: sequences.Array.data[0].steps.Array.data[3].subtitleText
      value: "Jekko: Aber, aber Kara! Du hast es doch fast geschafft. Nur noch eine
        kleine Aufgabe liegt vor dir. Na los... geh zur\xFCck in den Raum."
      objectReference: {fileID: 0}
