      propertyPath: sequences.Array.data[0].steps.Array.data[5].focusTarget
      value: 
      objectReference: {fileID: 777181378}
    - target: {fileID: 8334727942531066475, guid: c3b9b1aeebcb3e0438dfc54c33fc39d4, type: 3}
      propertyPath: sequences.Array.data[0].steps.Array.data[6].focusTarget
      value: 
      objectReference: {fileID: 775865287}
    - target: {fileID: 8334727942531066475, guid: c3b9b1aeebcb3e0438dfc54c33fc39d4, type: 3}
      propertyPath: sequences.Array.data[0].steps.Array.data[7].focusTarget
      value: 
      objectReference: {fileID: 777181378}
    - target: {fileID: 8334727942531066475, guid: c3b9b1aeebcb3e0438dfc54c33fc39d4, type: 3}
      propertyPath: sequences.Array.data[0].steps.Array.data[0].subtitleText
      value: 
      objectReference: {fileID: 0}
    - target: {fileID: 8334727942531066475, guid: c3b9b1aeebcb3e0438dfc54c33fc39d4, type: 3}
      propertyPath: sequences.Array.data[0].steps.Array.data[1].subtitleText
      value: 'JEKKO: Ok, also ich lass mich viel und oft und gern verarschen. Aber
        wer besitzt ein Telefon und bewahrt das Kabel separat auf?

'
      objectReference: {fileID: 0}
    - target: {fileID: 8334727942531066475, guid: c3b9b1aeebcb3e0438dfc54c33fc39d4, type: 3}
      propertyPath: sequences.Array.data[0].steps.Array.data[2].subtitleText
      value: "JEKKO: Das ist extra. Das muss es sein. (verzweifelt) Wer will uns
        denn so \xE4rgern??"
      objectReference: {fileID: 0}
    - target: {fileID: 8334727942531066475, guid: c3b9b1aeebcb3e0438dfc54c33fc39d4, type: 3}
      propertyPath: sequences.Array.data[0].steps.Array.data[3].subtitleText
      value: 'KARA: Keine Ahnung. Es spart halt Stromverbrauch oder so. .'
      objectReference: {fileID: 0}
    - target: {fileID: 8334727942531066475, guid: c3b9b1aeebcb3e0438dfc54c33fc39d4, type: 3}
      propertyPath: sequences.Array.data[0].steps.Array.data[4].subtitleText
      value: "KARA: Au\xDFerdem ruft eh nie jemand an, es macht keinen Unterschied,
        ob es eingesteckt ist oder nicht"
      objectReference: {fileID: 0}
    - target: {fileID: 8334727942531066475, guid: c3b9b1aeebcb3e0438dfc54c33fc39d4, type: 3}
      propertyPath: sequences.Array.data[0].steps.Array.data[5].subtitleText
      value: "JEKKO: Ja, aber jetzt m\xFCssen wir auch noch das verdammte Kabel daf\xFCr
        finden. Du bist auch das einzige Kind, was ich kenne, welches kein Handy
        besitzt."
      objectReference: {fileID: 0}
    - target: {fileID: 8334727942531066475, guid: c3b9b1aeebcb3e0438dfc54c33fc39d4, type: 3}
      propertyPath: sequences.Array.data[0].steps.Array.data[6].subtitleText
      value: "KARA: Brauch halt keins. Es ruft niemand an, es w\xFCrde keinen Unterschied
        machen. Au\xDFerdem, wie viele Kinder kennst du denn noch?"
      objectReference: {fileID: 0}
    - target: {fileID: 8334727942531066475, guid: c3b9b1aeebcb3e0438dfc54c33fc39d4, type: 3}
      propertyPath: sequences.Array.data[0].steps.Array.data[7].subtitleText
      value: 'JEKKO: Nun such einfach das verdammte Kabel.'
      objectReference: {fileID: 0}
    - target: {fileID: 8334727942531066475, guid: c3b9b1aeebcb3e0438dfc54c33fc39d4, type: 3}
      propertyPath: sequences.Array.data[0].steps.Array.data[8].subtitleText
