      propertyPath: sequences.Array.data[0].steps.Array.data[0].subtitleText
      value: 'Kara: Hey es passt. Aber..es sieht falsch aus. So als, ob es ein Bild
        ergeben soll. Ich krieg es aber nicht bewegt'
