    - target: {fileID: 4923332934719268576, guid: 1b90ee29d4f8f48408452ced94754ffd, type: 3}
      propertyPath: slots.Array.data[3].readablePages.Array.data[0].text
      value: "24. Juni 2009\n\nPapa und ich haben endlich den zweiten Star Wars Film
        geguckt! Ich hab zwar immer noch nicht ganz verstanden, warum der zweite
        Teil \u201EEpisode 5\u201C hei\xDFt, aber es wird schon stimmen, wenn Papa
        das sagt. Den Film fand ich sogar noch besser als den Ersten und Papa hat
        mir versprochen, dass wir am Wochenende zusammen in die Stadt fahren und
        ich mir ein Spielzeug "
      objectReference: {fileID: 0}
    - target: {fileID: 4923332934719268576, guid: 1b90ee29d4f8f48408452ced94754ffd, type: 3}
      propertyPath: slots.Array.data[3].readablePages.Array.data[1].text
      value: "Raumschiff aussuchen darf. Ich kann\u2019s kaum erwarten :)))"
      objectReference: {fileID: 0}
